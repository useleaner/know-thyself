# Somente no servidor/Vercel. Não colocar valores reais em HTML, JS público ou Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origem exata, sem barra final. Local: http://localhost:3000
APP_ORIGIN=
APP_ADDITIONAL_ORIGINS=
# Gere ao menos 32 bytes aleatórios; exemplo: openssl rand -hex 32
SESSION_SECRET=
# Contas Google autorizadas a ver a prévia, separadas por vírgula.
ALLOWED_GOOGLE_EMAILS=
# Administração de usuários: e-mails explícitos separados por vírgula. Vazio nega acesso. Nunca usar *.
ADMIN_EMAILS=
# Banco/perfis e inscrições Web Push cifradas (32 bytes em base64).
DATABASE_URL=
ENCRYPTION_KEY=
# Gere um par com web-push generate-vapid-keys; a chave privada fica só no servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato real do responsável, em formato mailto: ou https:.
VAPID_SUBJECT=
# Ao menos 32 caracteres; o cron Vercel envia Authorization: Bearer automaticamente.
CRON_SECRET=
